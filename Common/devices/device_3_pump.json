{
  "$schema": "../config.schema.json",
  "schema_version": "1.0",
  "device_id": "pump_ctrl_module_03",
  "name": "Блок управления насосной станцией МВ-03",
  "description": "Модуль дискретных сигналов управления (2 DI, 2 DO)",
  "slave_id": 3,
  "connection": {
    "type": "tcp",
    "tcp": {
      "host": "127.0.0.1",
      "port": 5020,
      "timeout_ms": 2000
    }
  },
  "polling": {
    "enabled": true,
    "poll_interval_ms": 500,
    "coefficients_poll_interval_ms": 30000,
    "max_retries": 3
  },
  "channels": [
    {
      "channel_id": "di_pump1_ready",
      "name": "Готовность насоса 1 к пуску",
      "type": "DI",
      "modbus": {
        "table": "discrete_inputs",
        "address": 0,
        "data_type": "bool"
      },
      "simulation": {
        "pattern": "constant",
        "initial_value": true
      }
    },
    {
      "channel_id": "di_pump2_ready",
      "name": "Готовность насоса 2 к пуску",
      "type": "DI",
      "modbus": {
        "table": "discrete_inputs",
        "address": 1,
        "data_type": "bool"
      },
      "simulation": {
        "pattern": "toggle",
        "initial_value": true,
        "toggle_interval_seconds": 20.0
      }
    },
    {
      "channel_id": "do_pump1_run",
      "name": "Пуск насоса 1",
      "type": "DO",
      "modbus": {
        "table": "coils",
        "address": 0,
        "data_type": "bool"
      },
      "simulation": {
        "pattern": "constant",
        "initial_value": false
      }
    },
    {
      "channel_id": "do_pump2_run",
      "name": "Пуск насоса 2",
      "type": "DO",
      "modbus": {
        "table": "coils",
        "address": 1,
        "data_type": "bool"
      },
      "simulation": {
        "pattern": "constant",
        "initial_value": false
      }
    }
  ]
}
